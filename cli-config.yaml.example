# Tangyuge-Hermes minimal config example.
#
# Runtime source of truth on the 81 server:
#   /home/hermes/.hermes/config.yaml
#
# This example intentionally omits upstream-only platforms and services such as
# Telegram, Discord, Slack, WhatsApp, Matrix, Feishu, WeCom, Portal, Honcho,
# Kanban, desktop/TUI/web UI, and generic bootstrap surfaces.

model:
  provider: minimax-cn
  default: minimax-m3

fallback_providers:
  - provider: deepseek
    model: deepseek-chat

prompt_caching:
  cache_ttl: 5m

agent:
  image_input_mode: auto

auxiliary:
  vision:
    provider: custom:ollama_vision

providers:
  ollama_vision:
    base_url: http://127.0.0.1:11434/v1
    model: qwen2.5vl:7b

image_gen:
  provider: hybgzs
  model: gemini-3.1-flash-image
  hybgzs:
    base_url: https://ai.hybgzs.com/v1
    model: gemini-3.1-flash-image
    timeout: 180

tts:
  provider: remote_gptsovits
  remote_gptsovits:
    base_url: http://127.0.0.1:19880
    tts_endpoint: /tts
    model: auto
    timeout: 300
    max_text_length: 2000

plugins:
  enabled:
    - rtk-rewrite

delegation:
  orchestrator_enabled: true
  max_spawn_depth: 1
  max_concurrent_children: 3
  max_async_children: 3
  child_timeout_seconds: 600

toolsets:
  qqbot:
    - hermes-qqbot
  api_server:
    - hermes-cli
  cli:
    - hermes-cli
  cron:
    - hermes-cli

web:
  backend: tavily

gateway:
  default_platform: qqbot

qqbot:
  # Real credentials belong in /home/hermes/.hermes/.env or server-local
  # config, not in this repository.
  app_id: ""
  secret: ""
  token: ""
