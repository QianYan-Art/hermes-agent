# Tangyuge-Hermes minimal environment example.
#
# Do not put real keys in this file. Runtime secrets live in
# /home/hermes/.hermes/.env on the 81 server.

# Main chat providers retained by this fork.
MINIMAX_CN_API_KEY=
DEEPSEEK_API_KEY=

# Optional web search backend used by the retained `web` toolset.
TAVILY_API_KEY=

# Optional image generation backend used by the retained `image_gen` toolset.
HYBGZS_API_KEY=

# QQBot runtime values are deployment-local. Keep real values only in the
# server runtime .env/config.yaml, never in repo docs or examples.
QQBOT_APP_ID=
QQBOT_SECRET=
QQBOT_TOKEN=

# Built-in provider env auto-discovery stays disabled unless intentionally
# restoring legacy behavior.
# HERMES_BUILTIN_ENV_PROVIDER_DISCOVERY=1
